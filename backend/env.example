APP_NAME=Titan
APP_VERSION=0.1.0

ENVIRONMENT=development
DEBUG=True

LOG_LEVEL=INFO

SECRET_KEY=replace_with_secure_secret

DATABASE_URL=postgresql+psycopg://titan:titan@localhost:5432/titan

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=titan_session
SESSION_COOKIE_SAMESITE=lax

CSRF_COOKIE_NAME=titan_csrf
CSRF_HEADER_NAME=X-CSRF-Token

TRUSTED_PROXY_IPS=

SENSOR_INGEST_API_KEY: str = "CHANGE_ME"
SENSOR_INGEST_HEADER_NAME: str = "X-Titan-Sensor-Key"